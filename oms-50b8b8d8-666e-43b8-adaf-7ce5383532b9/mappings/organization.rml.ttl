@prefix :     <https://example.org/ontology/organization#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

:DepartmentMap  a       rr:TriplesMap;
        rml:logicalSource      [ rml:referenceFormulation  ql:CSV;
                                 rml:source                "departments.csv"
                               ];
        rr:predicateObjectMap  [ rr:objectMap  [ rr:column    "department_name";
                                                 rr:datatype  xsd:string
                                               ];
                                 rr:predicate  :departmentName
                               ];
        rr:predicateObjectMap  [ rr:objectMap  [ rr:column    "department_id";
                                                 rr:datatype  xsd:string
                                               ];
                                 rr:predicate  :departmentId
                               ];
        rr:subjectMap          [ rr:class     :Department;
                                 rr:template  "https://example.org/resource/department/{department_id}"
                               ] .

:EmployeeMap  a         rr:TriplesMap;
        rml:logicalSource      [ rml:referenceFormulation  ql:CSV;
                                 rml:source                "employees.csv"
                               ];
        rr:predicateObjectMap  [ rr:objectMap  [ rr:joinCondition     [ rr:child   "department_id";
                                                                        rr:parent  "department_id"
                                                                      ];
                                                 rr:parentTriplesMap  :DepartmentMap
                                               ];
                                 rr:predicate  :worksIn
                               ];
        rr:predicateObjectMap  [ rr:objectMap  [ rr:column    "full_name";
                                                 rr:datatype  xsd:string
                                               ];
                                 rr:predicate  :fullName
                               ];
        rr:predicateObjectMap  [ rr:objectMap  [ rr:column    "employee_id";
                                                 rr:datatype  xsd:string
                                               ];
                                 rr:predicate  :employeeId
                               ];
        rr:subjectMap          [ rr:class     :Employee;
                                 rr:template  "https://example.org/resource/employee/{employee_id}"
                               ] .
